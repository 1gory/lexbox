{
  "name": "lexbox",
  "description": "Save English words and phrases as you read, with a Russian translation, and see them highlighted on every page.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "wxt build --mode e2e && playwright test",
    "store:assets": "node scripts/store-assets.mjs",
    "postinstall": "wxt prepare",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "author": "Igor Pershin <igor.pershin.me@gmail.com>",
  "license": "MIT"
}
